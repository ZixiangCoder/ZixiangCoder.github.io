---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import { site, withBase } from '../data/site';
import { experience, skillGroups } from '../data/resume';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: site.url,
  image: `${site.url}${withBase('/img/og.jpg')}`,
  jobTitle: experience[0]?.role,
  worksFor: { '@type': 'Organization', name: experience[0]?.company },
  email: `mailto:${site.author.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.author.location,
  },
  sameAs: [
    site.socials.github.url,
    site.socials.linkedin.url,
    ...(site.socials.instagram ? [site.socials.instagram.url] : []),
  ],
  knowsAbout: skillGroups.flatMap((g) => g.skills).slice(0, 8),
};
---

<Layout title={undefined} jsonLd={personJsonLd}>
  <Hero />
</Layout>
