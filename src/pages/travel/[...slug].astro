---
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { site, withBase } from '../../data/site';

export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({ params: { slug: trip.id }, props: { trip } }));
}

type Props = { trip: CollectionEntry<'trips'> };

const { trip } = Astro.props;
const { Content } = await render(trip);

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' });
const heroImage = withBase(trip.data.heroImage);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: trip.data.title,
  description: trip.data.summary,
  datePublished: trip.data.date.toISOString(),
  author: { '@type': 'Person', name: site.author.name },
  image: `${site.url}${heroImage}`,
};
---

<Layout
  title={trip.data.title}
  description={trip.data.summary}
  type="article"
  image={trip.data.heroImage}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href={withBase('/travel')}><Icon name="arrow-left" size={14} /> All trips</a>
      </nav>

      <header style="max-width: 70ch;">
        <div class="post-meta">
          <span class="category-badge life">travel</span>
          <span>{trip.data.place}</span>
          <span class="dot">·</span>
          <time datetime={trip.data.date.toISOString()}>{dateFmt.format(trip.data.date)}</time>
        </div>
        <h1 style="margin: 0.75rem 0 0.5rem;">{trip.data.title}</h1>
        <p class="muted" style="font-size: 1.1rem;">{trip.data.summary}</p>
      </header>

      <img
        src={heroImage}
        alt={trip.data.title}
        style="border-radius: var(--radius-lg); margin: 2rem 0; width: 100%; object-fit: cover; max-height: 480px;"
      />

      {trip.data.highlights.length > 0 && (
        <ul class="badge-row" style="list-style: none; padding: 0; margin: 0 0 1.5rem;">
          {trip.data.highlights.map((h) => <li class="badge">✦ {h}</li>)}
        </ul>
      )}

      <div class="prose" style="margin-top: 1rem;">
        <Content />
      </div>

      {trip.data.gallery.length > 0 && (
        <>
          <h2 style="margin-top: 3rem;">Gallery</h2>
          <Gallery items={trip.data.gallery.map(withBase)} title={trip.data.title} />
        </>
      )}

      <nav aria-label="Trip navigation" style="margin-top: 3rem;">
        <a href={withBase('/travel')}><Icon name="arrow-left" size={14} /> Back to all trips</a>
      </nav>
    </div>
  </article>
</Layout>
