---
import Layout from '../../components/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../data/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
const counts = new Map<string, number>();
for (const p of allPosts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
---

<Layout title="Blog" description="Notes, essays, and the occasional tangent — everything I've written lately.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Writings</h1>
      <p class="muted" style="max-width: 60ch;">
        Things I'm learning, building, or thinking about — sometimes technical, sometimes not.
      </p>

      {tags.length > 0 && (
        <div class="tag-list" style="margin: 1.5rem 0 2.5rem;">
          {tags.map((t) => (
            <a class="tag" href={withBase(`/blog/tags/${t}/`)}>#{t} <span style="opacity: 0.6;">({counts.get(t)})</span></a>
          ))}
        </div>
      )}

      <div class="post-list">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
</Layout>
