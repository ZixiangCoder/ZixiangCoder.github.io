---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../data/site';
---

<Layout title="404" description="Page not found" noindex>
  <section class="section center">
    <div class="container">
      <p class="eyebrow" style="margin-top: 2rem;">404</p>
      <h1 style="font-size: clamp(4rem, 12vw, 7rem); margin: 0;">404</h1>
      <p class="muted" style="max-width: 45ch; margin: 0 auto 1.5rem;">
        Looks like this page hit an authorization error — you don't have access to it (or it never
        existed). Either way, here's the way back.
      </p>
      <a class="btn btn-primary" href={withBase('/')}>Back home <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>
</Layout>
