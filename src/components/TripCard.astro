---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../data/site';

type Trip = CollectionEntry<'trips'>;

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric' });
---

<article>
  <a class="trip-card" href={withBase(`/travel/${trip.id}/`)}>
    <div class="thumb">
      <img src={withBase(trip.data.heroImage)} alt={trip.data.title} loading="lazy" />
    </div>
    <div class="body">
      <span class="meta">{trip.data.place} · {dateFmt.format(trip.data.date)}</span>
      <h3>{trip.data.title}</h3>
      <p>{trip.data.summary}</p>
    </div>
  </a>
</article>
