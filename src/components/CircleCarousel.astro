---
export interface Props {
  photos: string[];
  alt: string;
}

const { photos, alt } = Astro.props;
const photosJson = JSON.stringify(photos);
---

<div class="circle-carousel" data-photos={photosJson} data-alt={alt}>
  <div class="circle-ring">
    {photos.map(() => <img class="circle-photo" alt="" loading="lazy" draggable="false" />)}
  </div>
</div>

<script>
  const carousel = document.querySelector<HTMLElement>('.circle-carousel');
  if (!carousel) {
    throw new Error('CircleCarousel mount failed');
  }

  const photos: string[] = JSON.parse(carousel.dataset.photos ?? '[]');
  const alt = carousel.dataset.alt ?? '';
  const imgs = Array.from(carousel.querySelectorAll<HTMLImageElement>('.circle-photo'));

  const pool = photos.length >= 3 ? photos : [...photos, ...photos, ...photos];
  imgs.forEach((img, i) => {
    img.src = pool[i % pool.length];
    img.alt = alt;
  });

  let current = 0;
  imgs.forEach((img, i) => img.classList.toggle('is-visible', i === current));

  const next = () => {
    imgs[current].classList.remove('is-visible');
    current = (current + 1) % imgs.length;
    imgs[current].classList.add('is-visible');
  };

  setInterval(next, 2500);
</script>
