---
import { experience, earlierRoles } from '../data/resume';

const formatDate = (e: { start: string; end: string }) =>
  e.end === 'Present' ? `${e.start} – Present` : `${e.start} – ${e.end}`;
---

<section class="section section-alt" id="experience">
  <div class="container">
    <p class="eyebrow">Experience</p>
    <h2 class="section-heading">Where I've worked</h2>

    <ul class="timeline">
      {
        experience.map((e) => (
          <li class:list={['timeline-item', { current: e.current }]}>
            <details class="timeline-details">
              <summary class="timeline-head">
                <span class="timeline-title-wrap">
                  <span class="timeline-role">
                    {e.role}
                    <span class="timeline-company"> · {e.company}</span>
                  </span>
                  <span class="timeline-date">{formatDate(e)}</span>
                </span>
                <span class="timeline-chevron" aria-hidden="true">▸</span>
              </summary>
              <div class="timeline-body">
                <p class="timeline-summary">{e.summary}</p>
                <ul class="timeline-bullets">
                  {e.bullets.map((b) => <li>{b}</li>)}
                </ul>
                {e.badges && (
                  <div class="badge-row">
                    {e.badges.map((b) => <span class="badge">{b}</span>)}
                  </div>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <div class="earlier">
      <strong>Earlier:</strong>
      {
        earlierRoles.map((r) => (
          <span>{r.role}, {r.company} ({r.start})</span>
        ))
      }
    </div>
  </div>
</section>
