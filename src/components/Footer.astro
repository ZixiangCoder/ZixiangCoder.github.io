---
import { site, withBase } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href={withBase('/')}>Home</a></li>
      <li><a href={withBase('/work')}>Work</a></li>
      <li><a href={withBase('/blog')}>Blog</a></li>
      <li><a href={withBase('/travel')}>Travel</a></li>
    </ul>
    <ul class="footer-links">
      {Object.values(site.socials).map((s) => (
        <li>
          <a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>
        </li>
      ))}
    </ul>
    <p>© {new Date().getFullYear()} {site.author.name} · {site.author.location}</p>
  </div>
</footer>
